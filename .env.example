# Database Configuration
# Get this from Neon.tech or Railway PostgreSQL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# JWT Secret for authentication
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-secret-key-change-in-production

# Application Environment
NODE_ENV=production

# Port (Railway sets this automatically)
PORT=5000

# WhatsApp OTP Configuration
# Get your token from https://fonnte.com
# Without this token, OTP will be shown in the response (demo mode)
WHATSAPP_PROVIDER=fonnte
FONNTE_API_TOKEN=your-fonnte-api-token

# DOKU Payment Gateway Configuration
# Get from https://dashboard.doku.com
DOKU_CLIENT_ID=your-doku-client-id
DOKU_SECRET_KEY=your-doku-secret-key
DOKU_SHARED_KEY=your-doku-shared-key
DOKU_PRIVATE_KEY=your-doku-private-key-pem-format
DOKU_BASE_URL=https://api.doku.com

